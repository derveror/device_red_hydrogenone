/boot           emmc   /dev/block/bootdevice/by-name/boot       flags=slotselect;backup=1;flashimg=1;display="Boot"
/system_root    ext4   /dev/block/bootdevice/by-name/system     flags=slotselect;backup=1;wipeingui;display="System"
/system_image   emmc   /dev/block/bootdevice/by-name/system     flags=slotselect;backup=1;flashimg=1;display="System Image"
/vendor         ext4   /dev/block/bootdevice/by-name/vendor     flags=slotselect;backup=1;wipeingui;display="Vendor"
/vendor_image   emmc   /dev/block/bootdevice/by-name/vendor     flags=slotselect;backup=1;flashimg=1;display="Vendor Image"
/data           ext4   /dev/block/bootdevice/by-name/userdata   flags=backup=1;wipeingui;formattable;encryptable=footer;display="Data"
/misc           emmc   /dev/block/bootdevice/by-name/misc
/firmware       vfat   /dev/block/bootdevice/by-name/modem      flags=slotselect;mounttodecrypt;fsflags="ro,shortname=lower"
/bt_firmware    vfat   /dev/block/bootdevice/by-name/bluetooth  flags=slotselect;mounttodecrypt;fsflags="ro,shortname=lower"
/dsp            ext4   /dev/block/bootdevice/by-name/dsp        flags=slotselect;mounttodecrypt;fsflags="ro,nosuid,nodev,barrier=1"
/persist        ext4   /dev/block/bootdevice/by-name/persist    flags=mounttodecrypt;fsflags="ro,noatime,nosuid,nodev,barrier=1"
/external_sd    auto   /dev/block/mmcblk0p1                     flags=storage;wipeingui;removable;display="MicroSD"
/usb_otg        auto   /dev/block/sda1                          flags=storage;wipeingui;removable;display="USB-OTG"
