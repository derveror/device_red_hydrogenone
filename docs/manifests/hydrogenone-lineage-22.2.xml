<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <!--
        Clean-checkout template for RED Hydrogen One / LineageOS 22.2.
        Copy this file to .repo/local_manifests/hydrogenone.xml after repo init.
        The RED device branch and vendor revision are pinned to the pair
        verified by docs/reference/cross-tree-lock.json and the Android 15 gates.
    -->
    <remote name="derveror" fetch="https://github.com/derveror/" />
    <remote name="lineageos" fetch="https://github.com/LineageOS/" />

    <project
        name="device_red_hydrogenone"
        path="device/red/hydrogenone"
        remote="derveror"
        revision="118-lineage-22.2-kernel-302" />

    <project
        name="proprietary_vendor_red_hydrogenone"
        path="vendor/red/hydrogenone"
        remote="derveror"
        revision="8f69f96712bc8a2f683e59fbfb2379847970546b" />

    <project
        name="android_kernel_red_msm8998"
        path="kernel/red/msm8998"
        remote="derveror"
        revision="2fb7457475a6fb2de07ea603717dac6a83eecb1a" />

    <project
        name="android_device_qcom_sepolicy_vndr"
        path="device/qcom/sepolicy-legacy-um"
        remote="lineageos"
        revision="lineage-22.2-legacy-um" />
</manifest>
