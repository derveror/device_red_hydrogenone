import /vendor/etc/init/hw/init.qcom.usb.rc

# RED Hydrogen One H1A1000 - Android 15 control plane
on early-init
    mkdir /mnt/vendor/persist 0755 root root

on fs
    wait /dev/block/platform/soc/1da4000.ufshc
    symlink /dev/block/platform/soc/1da4000.ufshc /dev/block/bootdevice
    mount_all /vendor/etc/fstab.qcom --early
    swapon_all /vendor/etc/fstab.qcom

on late-fs
    mount_all /vendor/etc/fstab.qcom --late

on post-fs-data
    restorecon_recursive /mnt/vendor/persist

    # RED .118 secure/QCOM state previously addressed through /persist. Keep the
    # same hardware-owned directories under the Treble vendor persist mount.
    mkdir /mnt/vendor/persist/data 0700 system system
    mkdir /mnt/vendor/persist/data/tz 0700 system system
    mkdir /mnt/vendor/persist/data/app_g 0700 system system
    mkdir /mnt/vendor/persist/hvdcp_opti 0770 root system
    mkdir /mnt/vendor/persist/time 0770 system system

    mkdir /data/vendor 0771 root root
    mkdir /data/vendor/tombstones 0771 root root
    mkdir /data/vendor/qvr 0770 system system

on boot
    # FPC side-mounted fingerprint reader / power key
    chown system system /sys/bus/platform/devices/soc:fpc1020/irq
    chown system system /sys/bus/platform/devices/soc:fpc1020/wakeup_enable
    chown system system /sys/bus/platform/devices/soc:fpc1020/wakeup_feature
    chmod 0600 /sys/bus/platform/devices/soc:fpc1020/irq
    chmod 0200 /sys/bus/platform/devices/soc:fpc1020/wakeup_enable
    chmod 0200 /sys/bus/platform/devices/soc:fpc1020/wakeup_feature

    # RED SmartPort access. Optional hardware node: commands are harmless if absent.
    chown system system /sys/class/smartp/smartctrl/plug_det_n
    chown system system /sys/class/smartp/smartctrl/ext_gpio2
    chown system system /sys/class/smartp/smartctrl/vbus_out_en
    chown system system /sys/class/smartp/smartctrl/dc_in_en
    chown system system /sys/class/smartp/smartctrl/ext_gpio1
    chown system system /sys/class/smartp/smartctrl/acc_id_adc
    chown system system /sys/class/smartp/smartctrl/extswsel
    chown system system /sys/class/smartp/smartctrl/cam_rstn
