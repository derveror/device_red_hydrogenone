# RED Hydrogen One H1A1000 - stock-derived compatibility properties
# Graphics
ro.hardware.egl=adreno
ro.hardware.vulkan=adreno
ro.opengles.version=196610

# Bluetooth - stock Cherokee controller.  Keep the aliases used by older
# components, but expose the exact property read by the source vendor library.
vendor.qcom.bluetooth.soc=cherokee
qcom.bluetooth.soc=cherokee
vendor.bluetooth.soc=cherokee

# USB - RED .118 MSM8998 DWC3 gadget controller. Android 15 requires a
# Gadget HAL; FunctionFS is used for MTP/PTP as expected by the QTI service.
vendor.usb.controller=a800000.dwc3
vendor.usb.use_gadget_hal=1
vendor.usb.use_ffs_mtp=1
vendor.usb.rndis.func.name=rndis

# Radio - RED .118 canonical MPSS.AT modem + DSDS selects qcrild/qcrild2.
# Legacy vendor.rild.libpath is intentionally not advertised by this qcrild path.

# NFC
ro.hardware.nfc_nci=nqx.default

# Camera values present in RED stock vendor
persist.camera.expose.aux=1
persist.camera.sat.enable=1
persist.camera.halpp=1
persist.camera.dualfov.jpegnum=3
persist.camera.preview.ubwc=0
persist.camera.is.buffer_delay=10

# Display
vendor.display.enable_default_color_mode=true

# Vendor identity used by RED proprietary components
ro.vendor.product.model=H1A1000
ro.vendor.product.name=HydrogenONE
ro.vendor.product.device=HydrogenONE
