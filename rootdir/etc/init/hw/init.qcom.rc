import /vendor/etc/init/hw/init.qcom.usb.rc
import /vendor/etc/init/hw/init.target.rc

# RED Hydrogen One H1A1000 - Android 15 control plane
on early-init
    mkdir /mnt/vendor/persist 0755 root root

on fs
    wait /dev/block/platform/soc/1da4000.ufshc
    symlink /dev/block/platform/soc/1da4000.ufshc /dev/block/bootdevice
    mount_all /vendor/etc/fstab.qcom --early

    # RED .118 keeps the QSEE file-system listener state on the dedicated
    # cmlog partition. It must be mounted before post-fs starts qseecomd.
    chown root system /mnt/vendor/persist
    chmod 0771 /mnt/vendor/persist
    restorecon_recursive /mnt/vendor/persist
    mkdir /mnt/vendor/persist/data 0700 system system
    mount ext4 /dev/block/bootdevice/by-name/cmlog /mnt/vendor/persist/data noatime nosuid nodev barrier=1
    restorecon_recursive /mnt/vendor/persist/data

    swapon_all /vendor/etc/fstab.qcom

on late-fs
    mount_all /vendor/etc/fstab.qcom --late

on post-fs-data
    restorecon_recursive /mnt/vendor/persist

    # RED .118 secure/QCOM state previously addressed through /persist. Keep the
    # same hardware-owned directories under the Treble vendor persist mount.
    mkdir /mnt/vendor/persist/data 0700 system system
    mkdir /mnt/vendor/persist/data/tz 0700 system system
    mkdir /mnt/vendor/persist/data/app_g 0700 system system
    mkdir /mnt/vendor/persist/hvdcp_opti 0770 root system
    mkdir /mnt/vendor/persist/sensors 0770 system system
    mkdir /mnt/vendor/persist/sensors/registry 0770 system system
    mkdir /mnt/vendor/persist/time 0770 system system
    chown system system /mnt/vendor/persist/sensors
    chown system system /mnt/vendor/persist/sensors/sns.reg
    chmod 0664 /mnt/vendor/persist/sensors/sns.reg
    chown system system /mnt/vendor/persist/sensors/sensors_list.txt
    chown system system /mnt/vendor/persist/sensors/registry
    chown system system /mnt/vendor/persist/sensors/registry/registry
    chown system system /mnt/vendor/persist/sensors/registry/registry/sensors_registry
    chown system system /mnt/vendor/persist/sensors/sensors_settings
    chown system system /mnt/vendor/persist/sensors/registry/sns_reg_config
    chown system system /mnt/vendor/persist/sensors/registry/sns_reg_version
    chown system system /mnt/vendor/persist/sensors/registry/config
    chmod 0664 /mnt/vendor/persist/sensors/sensors_settings

    mkdir /data/vendor 0771 root root
    mkdir /data/vendor/tombstones 0771 root root
    mkdir /data/vendor/qvr 0770 system system

    # The AIDL supplicant copies its base configuration here before adding
    # wlan0 and places its control sockets below the same runtime tree.
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

on early-boot
    # The RED .118 sensor HAL is backed by the SLPI sensor DSP.
    write /sys/kernel/boot_slpi/boot 1

on boot
    # RED .118 canonical modem is MPSS.AT and stock is DSDS. Stock
    # init.class_main.sh therefore selects qcrild instances 1 and 2; qcrild3
    # is reserved for TSTS and legacy rild is the non-qcrild fallback.
    start vendor.qcrild
    start vendor.qcrild2

    # FPC side-mounted fingerprint reader / power key
    chown system system /sys/bus/platform/devices/soc:fpc1020/irq
    chown system system /sys/bus/platform/devices/soc:fpc1020/wakeup_enable
    chown system system /sys/bus/platform/devices/soc:fpc1020/wakeup_feature
    chmod 0600 /sys/bus/platform/devices/soc:fpc1020/irq
    chmod 0200 /sys/bus/platform/devices/soc:fpc1020/wakeup_enable
    chmod 0200 /sys/bus/platform/devices/soc:fpc1020/wakeup_feature

# RED .118 publishes modem services through the QRTR name service before the
# TFTP transport starts. Without this ordering ICNSS never sees WLAN QMI.
service vendor.qrtr-ns /vendor/bin/qrtr-ns -f
    class core
    user vendor_qrtr
    group vendor_qrtr
    capabilities NET_BIND_SERVICE

# IPC Router security must be applied before the modem requests WLAN firmware.
# This is the stock RED .118 order and is also retained by current MSM8998
# LineageOS devices including cheryl, mata, Pro1, Nokia, OnePlus and Xiaomi.
service vendor.irsc_util /vendor/bin/irsc_util "/vendor/etc/sec_config"
    class core
    user root
    oneshot

# RED .118 modem fetches wlanmdsp.mbn over the QRTR/TFTP transport during
# core startup. ICNSS cannot signal firmware-ready without this service.
service vendor.tftp_server /vendor/bin/tftp_server
    class core
    user root

# RED .118 WLAN firmware waits for this userspace WLFW client to deliver the
# board data and calibration report before advertising FW_READY to ICNSS.
service vendor.cnss-daemon /vendor/bin/cnss-daemon -n -l
    class late_start
    user system
    group system inet net_admin wifi
    capabilities NET_ADMIN

# RED .118 SSC registry daemon. The source-owned Android 15 HIDL wrapper loads
# sensors.ssc.so through /vendor/etc/sensors/hals.conf.
service vendor.sensors.qti /vendor/bin/sensors.qti
    class core
    user system
    group system
    disabled

service vendor-sensor-sh /vendor/bin/init.qcom.sensors.sh
    class core
    user root
    oneshot
