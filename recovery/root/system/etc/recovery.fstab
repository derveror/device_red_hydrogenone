# RED Hydrogen One H1A1000 — TWRP partition table
/boot          emmc  /dev/block/bootdevice/by-name/boot       flags=slotselect;backup=1;flashimg=1;display="Boot"
/system_root   ext4  /dev/block/bootdevice/by-name/system     flags=slotselect;backup=1;wipeingui;display="System"
/vendor        ext4  /dev/block/bootdevice/by-name/vendor     flags=slotselect;backup=1;wipeingui;display="Vendor"
/data          ext4  /dev/block/bootdevice/by-name/userdata   flags=backup=1;wipeingui;formattable;fileencryption=ice;quota;display="Data"
/misc          emmc  /dev/block/bootdevice/by-name/misc
/persist       ext4  /dev/block/bootdevice/by-name/persist    flags=backup=1;display="Persist"
/firmware      vfat  /dev/block/bootdevice/by-name/modem      flags=slotselect;backup=1;readonly;display="Modem firmware"
/bt_firmware   vfat  /dev/block/bootdevice/by-name/bluetooth  flags=slotselect;backup=1;readonly;display="Bluetooth firmware"
/dsp           ext4  /dev/block/bootdevice/by-name/dsp        flags=slotselect;backup=1;readonly;display="DSP"
/external_sd   auto  /dev/block/mmcblk1p1 /dev/block/mmcblk1  flags=display="Micro SDcard";storage;wipeingui;removable
/usb_otg       auto  /dev/block/sda1 /dev/block/sda            flags=display="USB-OTG";storage;removable
